<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>preview</LangVersion>
    <RootNamespace>Arkn.Extensions.Logging.Seq</RootNamespace>
    <AssemblyName>Arkn.Extensions.Logging.Seq</AssemblyName>
    <Version>0.3.2</Version>
    <Authors>Fernando Terra</Authors>
    <Description>Seq sink for Arkn.Logging — sends structured logs via HTTP using CLEF format. Zero Serilog dependency.</Description>
    <PackageTags>dotnet;csharp;seq;logging;clef;arkn</PackageTags>
    <RepositoryUrl>https://github.com/fernando-terra/arkn</RepositoryUrl>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.7" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Arkn.Logging\Arkn.Logging.csproj" />
  </ItemGroup>
</Project>
